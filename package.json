{
  "private": false,
  "displayName": "Sinope plugin for HomeBridge",
  "name": "@wfortin/homebridge-sinope",
  "version": "1.0.5",
  "description": "Neviweb thermostats, switches, outlets and dimmers with bounded requests and safe HomeKit handlers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexey-temnikov/homebridge-sinope.git"
  },
  "bugs": {
    "url": "https://github.com/alexey-temnikov/homebridge-sinope/issues"
  },
  "engines": {
    "node": "^22 || ^24 || ^26",
    "homebridge": ">=1.8.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src test --max-warnings=0",
    "build": "tsc",
    "test": "npm run build && node --unhandled-rejections=strict --test test/*.test.cjs",
    "check": "npm run lint && npm test",
    "watch": "tsc --watch",
    "prepack": "npm run check"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "homebridge": "2.4.0"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ]
}
